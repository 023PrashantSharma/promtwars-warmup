    "jspdf": "^2.5.2",
    "jspdf-autotable": "^5.0.8",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.514.0",
