    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^26.1.0",
    "@types/jspdf": "^2.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,css,md}": [
